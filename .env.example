# =============================================================
# TATU ON — Variables de entorno
# =============================================================
# El prototipo corre 100% con backend simulado (mock + localStorage).
# NO necesitas configurar nada para ejecutarlo: npm install && npm run dev
# -------------------------------------------------------------

# Backend: "false" = mock (por defecto) | "true" = Firebase real
VITE_USE_FIREBASE=false

# Solo requerido si VITE_USE_FIREBASE=true (pega aquí tu config de Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
