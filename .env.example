# =============================================================
# TATU ON — Variables de entorno
# Copia este archivo a .env (nunca subas .env al repo).
# =============================================================

# Backend: "mock" (localStorage, sin configuración) | "supabase"
VITE_BACKEND=mock

# --- Frontend (públicas: terminan en el bundle del navegador) ---
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Solo scripts locales (seed). NUNCA con prefijo VITE_ ni en Vercel ---
# SUPABASE_SERVICE_ROLE_KEY=
